# .env.example
# 完整配置步骤见 docs/local-setup-guide.md
# 生成与 JWT_SECRET 匹配的 ANON_KEY / SERVICE_ROLE_KEY：
#   node scripts/generate-supabase-keys.mjs
#
# Supabase
POSTGRES_PASSWORD=your-super-secret-password
JWT_SECRET=your-jwt-secret-at-least-32-chars
ANON_KEY=your-anon-key
SERVICE_ROLE_KEY=your-service-role-key

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=wardrobe-images

# AI Service（MODEL=ollama 本地调试；MODEL=bailian 需填写 BAILIAN_API_KEY）
MODEL=ollama
BAILIAN_API_KEY=your-bailian-api-key
BAILIAN_MODEL=qwen-vl-max

# Next.js
# NEXT_PUBLIC_SUPABASE_ANON_KEY 必须与上方 ANON_KEY 相同
# SUPABASE_SERVICE_ROLE_KEY 必须与上方 SERVICE_ROLE_KEY 相同
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_MINIO_ENDPOINT=localhost
NEXT_PUBLIC_MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wardrobe-images
# Docker 内 nextjs 容器用 http://fastapi:8001
# 本机 npm run dev 请在 nextjs/.env.local 写 http://localhost:8001
FASTAPI_URL=http://fastapi:8001
